        "# ============================================================\n",
        "# BANK LOAN PREDICTION USING NAIVE BAYES\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.naive_bayes import GaussianNB\n",
        "from sklearn.metrics import accuracy_score, confusion_matrix, ConfusionMatrixDisplay\n",
        "\n",
        "# 1. CREATE DATASET\n",
        "data = pd.DataFrame({\n",
        "    \"Income\": [25000, 30000, 45000, 50000, 60000, 70000,\n",
        "               35000, 80000, 55000, 90000, 20000, 75000],\n",
        "\n",
        "    \"CreditScore\": [550, 600, 650, 700, 720, 750,\n",
        "                    580, 800, 680, 820, 500, 780],\n",
        "\n",
        "    \"LoanAmount\": [200000, 250000, 300000, 350000,\n",
        "                   400000, 450000, 220000, 500000,\n",
        "                   320000, 550000, 180000, 480000],\n",
        "\n",
        "    \"LoanStatus\": [0, 0, 1, 1, 1, 1,\n",
        "                   0, 1, 1, 1, 0, 1]\n",
        "})\n",
        "\n",
        "print(\"BANK LOAN PREDICTION\")\n",
        "print(\"\\nTraining Dataset:\\n\")\n",
        "print(data)\n",
        "\n",
        "# 2. SPLIT DATASET\n",
        "X = data.drop(\"LoanStatus\", axis=1)\n",
        "y = data[\"LoanStatus\"]\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y, test_size=0.25, random_state=42, stratify=y\n",
        ")\n",
        "\n",
        "# 3. TRAIN NAIVE BAYES MODEL\n",
        "model = GaussianNB()\n",
        "model.fit(X_train, y_train)\n",
        "\n",
        "print(\"\\nLoan Prediction Model Trained Successfully!\")\n",
        "\n",
        "# 4. PREDICTION AND ACCURACY\n",
        "y_pred = model.predict(X_test)\n",
        "\n",
        "accuracy = accuracy_score(y_test, y_pred)\n",
        "\n",
        "print(\"\\nModel Accuracy:\", round(accuracy * 100, 2), \"%\")\n",
        "\n",
        "# 5. CONFUSION MATRIX\n",
        "cm = confusion_matrix(y_test, y_pred, labels=[0, 1])\n",
        "\n",
        "print(\"\\nConfusion Matrix:\\n\")\n",
        "print(cm)\n",
        "\n",
        "# 6. NEW CUSTOMER PREDICTION\n",
        "new_customer = pd.DataFrame({\n",
        "    \"Income\": [50000],\n",
        "    \"CreditScore\": [720],\n",
        "    \"LoanAmount\": [300000]\n",
        "})\n",
        "\n",
        "prediction = model.predict(new_customer)\n",
        "\n",
        "print(\"\\nNew Customer Details:\")\n",
        "print(new_customer)\n",
        "\n",
        "if prediction[0] == 1:\n",
        "    print(\"\\nLoan Status: Approved\")\n",
        "else:\n",
        "    print(\"\\nLoan Status: Not Approved\")\n",
        "\n",
        "# 7. GRAPH - CONFUSION MATRIX\n",
        "disp = ConfusionMatrixDisplay(\n",
        "    confusion_matrix=cm,\n",
        "    display_labels=[\"Not Approved\", \"Approved\"]\n",
        ")\n",
        "\n",
        "disp.plot(cmap=\"Blues\")\n",
        "plt.title(\"Bank Loan Prediction - Confusion Matrix\")\n",
        "plt.show()\n",
        "\n",
        "# 8. GRAPH - LOAN STATUS DISTRIBUTION\n",
        "status_counts = data[\"LoanStatus\"].value_counts().sort_index()\n",
        "\n",
        "plt.bar(\n",
        "    [\"Not Approved\", \"Approved\"],\n",
        "    status_counts.values\n",
        ")\n",
        "\n",
        "plt.title(\"Bank Loan Status Distribution\")\n",
        "plt.xlabel(\"Loan Status\")\n",
        "plt.ylabel(\"Number of Customers\")\n",
        "plt.show()"
      ]
