        "# ============================================================\n",
        "# FIND-S ALGORITHM - BAR CHART\n",
        "# Google Colab\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. TRAINING DATA\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "data = pd.DataFrame({\n",
        "    \"Sky\": [\"Sunny\", \"Sunny\", \"Rainy\", \"Sunny\", \"Sunny\"],\n",
        "    \"AirTemp\": [\"Warm\", \"Warm\", \"Cold\", \"Warm\", \"Cool\"],\n",
        "    \"Humidity\": [\"Normal\", \"High\", \"High\", \"High\", \"Normal\"],\n",
        "    \"Wind\": [\"Strong\", \"Strong\", \"Strong\", \"Weak\", \"Weak\"],\n",
        "    \"Water\": [\"Warm\", \"Warm\", \"Warm\", \"Warm\", \"Cool\"],\n",
        "    \"Forecast\": [\"Same\", \"Same\", \"Change\", \"Same\", \"Change\"],\n",
        "    \"EnjoySport\": [\"Yes\", \"Yes\", \"No\", \"Yes\", \"No\"]\n",
        "})\n",
        "\n",
        "print(\"===================================\")\n",
        "print(\"        FIND-S ALGORITHM\")\n",
        "print(\"===================================\")\n",
        "\n",
        "print(\"\\nTraining Data:\\n\")\n",
        "print(data)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. FIND-S ALGORITHM\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "attributes = list(data.columns[:-1])\n",
        "\n",
        "# Start with most specific hypothesis\n",
        "hypothesis = [\"Ø\"] * len(attributes)\n",
        "\n",
        "specific_count = []\n",
        "general_count = []\n",
        "\n",
        "for _, row in data.iterrows():\n",
        "\n",
        "    # Consider only positive examples\n",
        "    if row[\"EnjoySport\"] == \"Yes\":\n",
        "\n",
        "        for i in range(len(attributes)):\n",
        "\n",
        "            if hypothesis[i] == \"Ø\":\n",
        "                hypothesis[i] = row[attributes[i]]\n",
        "\n",
        "            elif hypothesis[i] != row[attributes[i]]:\n",
        "                hypothesis[i] = \"?\"\n",
        "\n",
        "        # Count specific and generalized attributes\n",
        "        specific = 0\n",
        "        general = 0\n",
        "\n",
        "        for value in hypothesis:\n",
        "\n",
        "            if value == \"?\":\n",
        "                general += 1\n",
        "            else:\n",
        "                specific += 1\n",
        "\n",
        "        specific_count.append(specific)\n",
        "        general_count.append(general)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. FINAL HYPOTHESIS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n===================================\")\n",
        "print(\"FINAL MOST SPECIFIC HYPOTHESIS\")\n",
        "print(\"===================================\")\n",
        "\n",
        "print(\"<\", end=\" \")\n",
        "\n",
        "for value in hypothesis:\n",
        "    print(value, end=\" \")\n",
        "\n",
        "print(\">\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. DISPLAY ATTRIBUTE DETAILS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nAttribute-wise Hypothesis:\")\n",
        "\n",
        "for attribute, value in zip(attributes, hypothesis):\n",
        "    print(attribute, \"=\", value)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. BAR CHART\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Changed X-axis names\n",
        "stages = [\n",
        "    \"Initial Hypothesis\",\n",
        "    \"First Generalization\",\n",
        "    \"Final Hypothesis\"\n",
        "]\n",
        "\n",
        "x = range(len(stages))\n",
        "\n",
        "width = 0.35\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "plt.bar(\n",
        "    [i - width/2 for i in x],\n",
        "    specific_count,\n",
        "    width=width,\n",
        "    label=\"Specific Attributes\"\n",
        ")\n",
        "\n",
        "plt.bar(\n",
        "    [i + width/2 for i in x],\n",
        "    general_count,\n",
        "    width=width,\n",
        "    label=\"Generalized Attributes (?)\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Hypothesis Development Stage\")\n",
        "plt.ylabel(\"Number of Attributes\")\n",
        "\n",
        "plt.title(\n",
        "    \"FIND-S Algorithm: Hypothesis Development\"\n",
        ")\n",
        "\n",
        "plt.xticks(x, stages, rotation=10)\n",
        "\n",
        "plt.legend()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. DISPLAY VALUES ON BARS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "for i, value in enumerate(specific_count):\n",
        "\n",
        "    plt.text(\n",
        "        i - width/2,\n",
        "        value + 0.1,\n",
        "        str(value),\n",
        "        ha=\"center\",\n",
        "        fontsize=11\n",
        "    )\n",
        "\n",
        "for i, value in enumerate(general_count):\n",
        "\n",
        "    plt.text(\n",
        "        i + width/2,\n",
        "        value + 0.1,\n",
        "        str(value),\n",
        "        ha=\"center\",\n",
        "        fontsize=11\n",
        "    )\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. RESULT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n===================================\")\n",
        "print(\"RESULT\")\n",
        "print(\"===================================\")\n",
        "\n",
        "print(\"Most Specific Hypothesis:\")\n",
        "\n",
        "print(\"<\", end=\" \")\n",
        "\n",
        "for value in hypothesis:\n",
        "    print(value, end=\" \")\n",
        "\n",
        "print(\">\")\n",
        "\n",
        "print(\"\\nFIND-S algorithm completed successfully!\")"
      ]
