        "# ============================================================\n",
        "# FUTURE SALES PREDICTION\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import mean_squared_error\n",
        "\n",
        "# 1. CREATE DATASET\n",
        "months = np.arange(1, 13).reshape(-1, 1)\n",
        "\n",
        "sales = np.array([\n",
        "    10000, 12000, 15000, 14000,\n",
        "    18000, 20000, 22000, 21000,\n",
        "    25000, 27000, 30000, 32000\n",
        "])\n",
        "\n",
        "print(\"FUTURE SALES PREDICTION\")\n",
        "print(\"Total Months:\", len(months))\n",
        "\n",
        "# 2. BUILD MODEL\n",
        "model = LinearRegression()\n",
        "\n",
        "model.fit(months, sales)\n",
        "\n",
        "print(\"\\nSales Prediction Model trained successfully!\")\n",
        "\n",
        "# 3. PREDICT FUTURE SALES\n",
        "future_months = np.array([[13], [14], [15]])\n",
        "\n",
        "future_sales = model.predict(future_months)\n",
        "\n",
        "print(\"\\nFUTURE SALES PREDICTION\")\n",
        "\n",
        "for month, sale in zip(future_months, future_sales):\n",
        "    print(\"Month\", month[0],\n",
        "          \"Predicted Sales: Rs.\", round(sale, 2))\n",
        "\n",
        "# 4. CALCULATE ERROR\n",
        "predicted_sales = model.predict(months)\n",
        "\n",
        "mse = mean_squared_error(sales, predicted_sales)\n",
        "\n",
        "print(\"\\nMODEL PERFORMANCE\")\n",
        "print(\"Mean Squared Error:\", round(mse, 2))\n",
        "\n",
        "# 5. GRAPH\n",
        "all_months = np.arange(1, 16).reshape(-1, 1)\n",
        "\n",
        "all_sales = model.predict(all_months)\n",
        "\n",
        "plt.figure(figsize=(7, 4))\n",
        "\n",
        "plt.scatter(months, sales, label=\"Actual Sales\")\n",
        "\n",
        "plt.plot(\n",
        "    all_months,\n",
        "    all_sales,\n",
        "    linestyle=\"--\",\n",
        "    label=\"Predicted Sales\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Month\")\n",
        "plt.ylabel(\"Sales (Rs.)\")\n",
        "plt.title(\"Future Sales Prediction\")\n",
        "\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 6. RESULT\n",
        "print(\"\\nRESULT\")\n",
        "print(\"Future Sales Prediction completed successfully.\")"
      ]
