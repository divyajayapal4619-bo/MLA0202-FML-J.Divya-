        "# ============================================================\n",
        "# DECISION TREE USING ID3 ALGORITHM\n",
        "# Google Colab - Dataset + Tree + Prediction + Bar Chart\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.tree import DecisionTreeClassifier, plot_tree\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. CREATE DATASET\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "data = pd.DataFrame({\n",
        "    \"Outlook\": [\n",
        "        \"Sunny\", \"Sunny\", \"Overcast\", \"Rain\",\n",
        "        \"Rain\", \"Rain\", \"Overcast\", \"Sunny\",\n",
        "        \"Sunny\", \"Rain\", \"Sunny\", \"Overcast\",\n",
        "        \"Overcast\", \"Rain\"\n",
        "    ],\n",
        "    \"Temperature\": [\n",
        "        \"Hot\", \"Hot\", \"Hot\", \"Mild\",\n",
        "        \"Cool\", \"Cool\", \"Cool\", \"Mild\",\n",
        "        \"Cool\", \"Mild\", \"Mild\", \"Mild\",\n",
        "        \"Hot\", \"Mild\"\n",
        "    ],\n",
        "    \"Humidity\": [\n",
        "        \"High\", \"High\", \"High\", \"High\",\n",
        "        \"Normal\", \"Normal\", \"Normal\", \"High\",\n",
        "        \"Normal\", \"Normal\", \"Normal\", \"High\",\n",
        "        \"Normal\", \"High\"\n",
        "    ],\n",
        "    \"Wind\": [\n",
        "        \"Weak\", \"Strong\", \"Weak\", \"Weak\",\n",
        "        \"Weak\", \"Strong\", \"Strong\", \"Weak\",\n",
        "        \"Weak\", \"Weak\", \"Strong\", \"Strong\",\n",
        "        \"Weak\", \"Strong\"\n",
        "    ],\n",
        "    \"Play\": [\n",
        "        \"No\", \"No\", \"Yes\", \"Yes\",\n",
        "        \"Yes\", \"No\", \"Yes\", \"No\",\n",
        "        \"Yes\", \"Yes\", \"Yes\", \"Yes\",\n",
        "        \"Yes\", \"No\"\n",
        "    ]\n",
        "})\n",
        "\n",
        "print(\"===================================\")\n",
        "print(\" DECISION TREE USING ID3 ALGORITHM\")\n",
        "print(\"===================================\")\n",
        "\n",
        "print(\"\\nTraining Dataset:\\n\")\n",
        "print(data)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. ENCODE CATEGORICAL DATA\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "X = data.drop(\"Play\", axis=1)\n",
        "y = data[\"Play\"]\n",
        "\n",
        "encoders = {}\n",
        "\n",
        "X_encoded = X.copy()\n",
        "\n",
        "for column in X.columns:\n",
        "    encoders[column] = LabelEncoder()\n",
        "    X_encoded[column] = encoders[column].fit_transform(X[column])\n",
        "\n",
        "target_encoder = LabelEncoder()\n",
        "y_encoded = target_encoder.fit_transform(y)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. BUILD DECISION TREE\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "model = DecisionTreeClassifier(\n",
        "    criterion=\"entropy\",\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "model.fit(X_encoded, y_encoded)\n",
        "\n",
        "print(\"\\nDecision Tree built successfully!\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. DISPLAY DECISION TREE\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(16, 8))\n",
        "\n",
        "plot_tree(\n",
        "    model,\n",
        "    feature_names=X.columns,\n",
        "    class_names=target_encoder.classes_,\n",
        "    filled=True,\n",
        "    rounded=True\n",
        ")\n",
        "\n",
        "plt.title(\"Decision Tree Using ID3 (Entropy)\")\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. CLASSIFY A NEW SAMPLE\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "new_sample = pd.DataFrame({\n",
        "    \"Outlook\": [\"Overcast\"],\n",
        "    \"Temperature\": [\"Cool\"],\n",
        "    \"Humidity\": [\"Normal\"],\n",
        "    \"Wind\": [\"Weak\"]\n",
        "})\n",
        "\n",
        "new_sample_encoded = new_sample.copy()\n",
        "\n",
        "for column in X.columns:\n",
        "    new_sample_encoded[column] = encoders[column].transform(\n",
        "        new_sample[column]\n",
        "    )\n",
        "\n",
        "prediction = model.predict(new_sample_encoded)\n",
        "\n",
        "predicted_class = target_encoder.inverse_transform(prediction)\n",
        "\n",
        "print(\"\\n===================================\")\n",
        "print(\"NEW SAMPLE CLASSIFICATION\")\n",
        "print(\"===================================\")\n",
        "\n",
        "print(new_sample)\n",
        "print(\"\\nPredicted Result:\", predicted_class[0])\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. BAR CHART\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "class_counts = data[\"Play\"].value_counts()\n",
        "\n",
        "plt.figure(figsize=(6, 4))\n",
        "\n",
        "plt.bar(class_counts.index, class_counts.values)\n",
        "\n",
        "plt.xlabel(\"Play Decision\")\n",
        "plt.ylabel(\"Number of Samples\")\n",
        "plt.title(\"Play vs Don't Play - Dataset\")\n",
        "\n",
        "for i, value in enumerate(class_counts.values):\n",
        "    plt.text(i, value + 0.1, str(value), ha=\"center\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. RESULT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n===================================\")\n",
        "print(\"RESULT\")\n",
        "print(\"===================================\")\n",
        "\n",
        "print(\"ID3 decision tree constructed successfully.\")\n",
        "print(\"New sample classified as:\", predicted_class[0])"
      ]
