        "# ============================================================\n",
        "# CANDIDATE-ELIMINATION ALGORITHM\n",
        "# Google Colab - CSV File + Bar Chart\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from itertools import product\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. CREATE TRAINING DATA AND SAVE AS CSV\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "data = pd.DataFrame({\n",
        "    \"Sky\": [\"Sunny\", \"Sunny\", \"Rainy\", \"Sunny\"],\n",
        "    \"AirTemp\": [\"Warm\", \"Warm\", \"Cold\", \"Warm\"],\n",
        "    \"Humidity\": [\"Normal\", \"High\", \"High\", \"High\"],\n",
        "    \"Wind\": [\"Strong\", \"Strong\", \"Strong\", \"Weak\"],\n",
        "    \"EnjoySport\": [\"Yes\", \"Yes\", \"No\", \"Yes\"]\n",
        "})\n",
        "\n",
        "data.to_csv(\"training_data.csv\", index=False)\n",
        "\n",
        "# Read data from CSV file\n",
        "data = pd.read_csv(\"training_data.csv\")\n",
        "\n",
        "print(\"===================================\")\n",
        "print(\" CANDIDATE-ELIMINATION ALGORITHM\")\n",
        "print(\"===================================\")\n",
        "\n",
        "print(\"\\nTraining Data:\\n\")\n",
        "print(data)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. INITIALIZE S AND G BOUNDARIES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "attributes = list(data.columns[:-1])\n",
        "num_attributes = len(attributes)\n",
        "\n",
        "S = [\"Ø\"] * num_attributes\n",
        "G = [[\"?\"] * num_attributes]\n",
        "\n",
        "# Store boundary counts for the graph\n",
        "s_counts = []\n",
        "g_counts = []\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. CANDIDATE-ELIMINATION ALGORITHM\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "for _, row in data.iterrows():\n",
        "\n",
        "    example = list(row.iloc[:-1])\n",
        "    target = row.iloc[-1]\n",
        "\n",
        "    if target == \"Yes\":\n",
        "\n",
        "        # Generalize S to cover positive examples\n",
        "        for i in range(num_attributes):\n",
        "\n",
        "            if S[i] == \"Ø\":\n",
        "                S[i] = example[i]\n",
        "\n",
        "            elif S[i] != example[i]:\n",
        "                S[i] = \"?\"\n",
        "\n",
        "        # Remove G hypotheses that do not cover\n",
        "        # the positive example\n",
        "        G = [\n",
        "            g for g in G\n",
        "            if all(g[i] == \"?\" or g[i] == example[i]\n",
        "                   for i in range(num_attributes))\n",
        "        ]\n",
        "\n",
        "    else:\n",
        "\n",
        "        # Specialize G to exclude negative examples\n",
        "        new_G = []\n",
        "\n",
        "        for g in G:\n",
        "\n",
        "            if all(g[i] == \"?\" or g[i] == example[i]\n",
        "                   for i in range(num_attributes)):\n",
        "\n",
        "                for i in range(num_attributes):\n",
        "\n",
        "                    if S[i] == \"?\":\n",
        "                        continue\n",
        "\n",
        "                    if S[i] != \"Ø\" and S[i] != example[i]:\n",
        "                        continue\n",
        "\n",
        "                    if g[i] == \"?\":\n",
        "\n",
        "                        new_hypothesis = g.copy()\n",
        "                        new_hypothesis[i] = example[i]\n",
        "\n",
        "                        # Keep only hypotheses more general\n",
        "                        # than or equal to S\n",
        "                        if all(\n",
        "                            S[j] == \"Ø\"\n",
        "                            or new_hypothesis[j] == \"?\"\n",
        "                            or new_hypothesis[j] == S[j]\n",
        "                            for j in range(num_attributes)\n",
        "                        ):\n",
        "                            new_G.append(new_hypothesis)\n",
        "\n",
        "            else:\n",
        "                new_G.append(g)\n",
        "\n",
        "        G = new_G\n",
        "\n",
        "    # Remove duplicate hypotheses\n",
        "    unique_G = []\n",
        "\n",
        "    for g in G:\n",
        "        if g not in unique_G:\n",
        "            unique_G.append(g)\n",
        "\n",
        "    G = unique_G\n",
        "\n",
        "    # Record boundary counts\n",
        "    s_counts.append(sum(1 for x in S if x != \"?\"))\n",
        "    g_counts.append(len(G))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. DISPLAY FINAL BOUNDARIES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n===================================\")\n",
        "print(\"FINAL SPECIFIC BOUNDARY (S)\")\n",
        "print(\"===================================\")\n",
        "\n",
        "print(\"<\", *S, \">\")\n",
        "\n",
        "print(\"\\n===================================\")\n",
        "print(\"FINAL GENERAL BOUNDARY (G)\")\n",
        "print(\"===================================\")\n",
        "\n",
        "if G:\n",
        "    for g in G:\n",
        "        print(\"<\", *g, \">\")\n",
        "else:\n",
        "    print(\"Empty boundary\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. DISPLAY ALL HYPOTHESES CONSISTENT WITH DATA\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n===================================\")\n",
        "print(\"CONSISTENT HYPOTHESIS SPACE\")\n",
        "print(\"===================================\")\n",
        "\n",
        "# Generate all possible hypotheses using observed values\n",
        "# and '?' for any attribute\n",
        "domains = [\n",
        "    list(data[attribute].unique()) + [\"?\"]\n",
        "    for attribute in attributes\n",
        "]\n",
        "\n",
        "all_hypotheses = list(product(*domains))\n",
        "consistent_hypotheses = []\n",
        "\n",
        "for h in all_hypotheses:\n",
        "\n",
        "    consistent = True\n",
        "\n",
        "    for _, row in data.iterrows():\n",
        "\n",
        "        example = list(row.iloc[:-1])\n",
        "        target = row.iloc[-1]\n",
        "\n",
        "        covers = all(\n",
        "            h[i] == \"?\" or h[i] == example[i]\n",
        "            for i in range(num_attributes)\n",
        "        )\n",
        "\n",
        "        if target == \"Yes\" and not covers:\n",
        "            consistent = False\n",
        "            break\n",
        "\n",
        "        if target == \"No\" and covers:\n",
        "            consistent = False\n",
        "            break\n",
        "\n",
        "    if consistent:\n",
        "        consistent_hypotheses.append(h)\n",
        "\n",
        "for h in consistent_hypotheses:\n",
        "    print(\"<\", *h, \">\")\n",
        "\n",
        "print(\"\\nTotal consistent hypotheses:\",\n",
        "      len(consistent_hypotheses))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. BAR CHART\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "examples = [f\"Example {i}\" for i in range(1, len(data) + 1)]\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "x = range(len(examples))\n",
        "width = 0.35\n",
        "\n",
        "plt.bar(\n",
        "    [i - width/2 for i in x],\n",
        "    s_counts,\n",
        "    width=width,\n",
        "    label=\"Specific Boundary (S)\"\n",
        ")\n",
        "\n",
        "plt.bar(\n",
        "    [i + width/2 for i in x],\n",
        "    g_counts,\n",
        "    width=width,\n",
        "    label=\"General Boundary (G)\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Training Data Examples\")\n",
        "plt.ylabel(\"Number of Hypotheses / Specific Attributes\")\n",
        "plt.title(\"Candidate-Elimination Algorithm\")\n",
        "plt.xticks(x, examples)\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. RESULT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n===================================\")\n",
        "print(\"RESULT\")\n",
        "print(\"===================================\")\n",
        "print(\"Candidate-Elimination algorithm completed successfully!\")\n",
        "print(\"CSV file created: training_data.csv\")"
      ]
    }
  ]
